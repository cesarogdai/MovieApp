@page "/reports"
@inject IReportService ReportService

<PageTitle>Reports · CineMatch</PageTitle>

<h1>Genre Report</h1>

<div class="filter-row">
    <div class="filter-group">
        <label>Min Vote Average</label>
        <select @bind="_minVote">
            <option value="0">Any</option>
            <option value="6">6.0+</option>
            <option value="7">7.0+</option>
            <option value="8">8.0+</option>
        </select>
    </div>

    <div class="filter-group">
        <label>Sort By</label>
        <select @bind="_sortBy">
            <option value="AverageVote">Average Vote</option>
            <option value="HighestVote">Highest Vote</option>
            <option value="MovieCount">Movie Count</option>
        </select>
    </div>

    <div class="filter-group">
        <label>Top N Genres</label>
        <select @bind="_take">
            <option value="5">Top 5</option>
            <option value="10">Top 10</option>
            <option value="20">Top 20</option>
        </select>
    </div>

    <button class="btn-primary" @onclick="RunReport" disabled="@_loading">
        @(_loading ? "Running…" : "Run Report")
    </button>
</div>

@if (_loading)
{
    <p class="status">Running report…</p>
}
else if (_error is not null)
{
    <p class="status error">@_error</p>
}
else if (_rows.Count == 0)
{
    <p class="status">No data. Try lowering the minimum vote.</p>
}
else
{
    <table class="report-table">
        <thead>
            <tr>
                <th>Genre</th>
                <th class="num">Movies</th>
                <th class="num">Avg Vote</th>
                <th class="num">Highest</th>
                <th>Top Movie</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td>@row.GenreName</td>
                    <td class="num">@row.MovieCount</td>
                    <td class="num">@row.AverageVote.ToString("0.00")</td>
                    <td class="num">@row.HighestVote.ToString("0.00")</td>
                    <td>@(row.TopMovieTitle ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private int _minVote = 0;
    private string _sortBy = "AverageVote";
    private int _take = 10;
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<GenreReportRow> _rows = Array.Empty<GenreReportRow>();

    protected override async Task OnInitializedAsync() => await RunReport();

    private async Task RunReport()
    {
        _loading = true;
        _error = null;

        try
        {
            var request = new GenreReportRequest(
                MinVoteAverage: _minVote,
                Take: _take,
                SortBy: _sortBy);

            _rows = await ReportService.GetGenreReportAsync(request);
        }
        catch (Exception ex)
        {
            _error = $"Report failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}