@* Reusable card component*@

<div class ="movie-card">
    <h3>@Title (@Year)</h3>
    <p>@Overview </p>
    <button @onclick="OnRateClicked">Rate</button>
    <p>@Stars</p>
    <h3><a href="/movies/@TmdbId">@Title (@Year)</a></h3>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public int Year { get; set; }

    [Parameter]
    public string Overview { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnRate { get; set; }   

    [Parameter]
    public int Rating { get; set; }

    private string Stars => new string('★', Rating) + new string('☆', 5 - Rating);

    [Parameter]
    public int TmdbId { get; set; }



    private async Task OnRateClicked()
    {
        await OnRate.InvokeAsync();
    }
}